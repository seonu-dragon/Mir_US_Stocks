# Python build artifacts
__pycache__/
*.pyc

# Local secrets (GitHub Actions uses Repository Secrets)
.env
.env.bak*

# 로컬 실험·산출물. 여기 새로 생기는 파일은 커밋 대상이 아니다.
# 주의: 이미 추적 중인 파일은 무시 규칙의 영향을 받지 않는다 —
#   outputs/ 의 .gitkeep 3개(디렉터리 유지용)와 scratch/ 의 기존 스크립트 37개는
#   그대로 남는다. 그것들을 저장소에서 빼려면 git rm --cached 로 따로 정리해야 한다.
scratch/
outputs/
terminals/

# Claude Code 로컬 설정(머신마다 다름)
.claude/settings.local.json

# OS / editor cruft
.DS_Store
Thumbs.db

# DART 공시 5년 백필 원본(76만건). 통계 산출용 중간 산출물이라 커밋하지 않는다 —
# 브라우저는 집계 파일만 읽고, 필요하면 backfill_kr_disclosures.py 가 다시 만든다.
data/korea/_archive/

# US 스냅샷의 .js 사본(~6MB). 브라우저는 .json 을 fetch 하고 deploy-pages.yml 도 이
# 파일을 아티팩트에서 지운다 — 유일한 용도는 file:// 로 index.html 을 직접 열 때의
# 폴백(app.js loadSnapshotScript)이라 update_data.py 가 로컬에 계속 만들되 커밋은
# 하지 않는다(2026-09-03, 하루 ~20커밋 × 6MB 가 .git 을 키우던 주범).
# KR 쪽(data/korea/market_snapshot.js, 3.2MB)도 같은 이유로 추적하지 않는다(2026-09-03).
data/market_snapshot.js
data/korea/market_snapshot.js

# 테스트·에이전트 잔여물
.pytest_cache/
.claude/worktrees/

# 배포 번들 산출물. scripts/build_bundle.mjs 가 --apply 로 만드는데, 배포는 _site/
# 스테이징 사본 안에서만 번들하고 레포의 HTML 은 그대로 둔다(CLAUDE.md '배포 번들').
# 로컬에서 --apply 를 돌려 보면 여기 생기므로 커밋 대상이 아니다.
dist/

# 2026-09-03 전수조사: 사이트가 서빙하지 않는 바이너리는 추적하지 않는다.
# 이미 커밋된 것은 이력에 남아 있어 `git checkout <sha> -- <경로>` 로 꺼낼 수 있다.
# 원본은 AI/SNS(및 카드뉴스는 AI/카드뉴스/daily)에 그대로 있고, 여기 사본은
# 하루 ~15MB 씩 pack 만 불렸다. 텍스트 산출물(05_final·기사·대장)은 계속 커밋한다.
SNS/**/05_generated_images/
SNS/**/07_card_news_final/
SNS/**/*.png
SNS/**/*.jpg
data/참고/
scripts/update_log.txt

# 구독 피드(.ics/RSS). deploy-pages.yml 이 _site/ 안에서 scripts/gen_feeds.py 로 매 배포마다 만든다.
# 로컬에서 화면 확인용으로 돌려 본 산출물은 커밋하지 않는다.
data/feeds/
